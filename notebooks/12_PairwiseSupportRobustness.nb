   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<PairwiseSupport analysis started: \>\"", ",", 
      RowBox[{"DateString", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<ISODate\>\"", ",", "\"\< \>\"", ",", "\"\<Time\>\""}], 
        "}"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pairwiseRunSeconds", ",", "pairwiseRows"}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"sourceRow", ",", "A", ",", "analysis"}], "}"}], ",", 
          RowBox[{
           RowBox[{"sourceRow", "=", 
            RowBox[{"regeneratedProfiles", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"A", "=", 
            RowBox[{"sourceRow", "[", "\"\<profile\>\"", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"analysis", "=", 
            RowBox[{"AnalyzeProfile", "[", 
             RowBox[{"A", ",", 
              RowBox[{"\"\<LegitimacySignal\>\"", "->", "legitimacySignal"}], 
              ",", 
              RowBox[{"\"\<pMin\>\"", "->", "pMin"}], ",", 
              RowBox[{"\"\<pMax\>\"", "->", "pMax"}], ",", 
              RowBox[{"\"\<InitialGridSize\>\"", "->", "initialGridSize"}], ",", 
              RowBox[{"\"\<RefineSteps\>\"", "->", "refineSteps"}], ",", 
              RowBox[{"\"\<RefineFactor\>\"", "->", "refineFactor"}], ",", 
              
              RowBox[{"\"\<InitialRefineHalfWidthU\>\"", "->", 
               "initialRefineHalfWidthU"}], ",", 
              RowBox[{"\"\<TieBreak\>\"", "->", "tieBreak"}], ",", 
              RowBox[{"\"\<DegenerateEps\>\"", "->", "degenerateEps"}], ",", 
              RowBox[{"\"\<IncludeDegenerateDiagnostic\>\"", "->", "True"}], ",", 
              
              RowBox[{"\"\<DiagnosticFinitePMax\>\"", "->", 
               "diagnosticFinitePMax"}], ",", 
              
              RowBox[{"\"\<DiagnosticGridIntervals\>\"", "->", 
               "diagnosticGridIntervals"}], ",", 
              
              RowBox[{"\"\<DiagnosticRefineSteps\>\"", "->", 
               "diagnosticRefineSteps"}], ",", 
              
              RowBox[{"\"\<DiagnosticRefineFactor\>\"", "->", 
               "diagnosticRefineFactor"}], ",", 
              
              RowBox[{"\"\<DiagnosticIncludeInfinity\>\"", "->", 
               "diagnosticIncludeInfinity"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"analysis", "===", "$Failed"}], "||", 
              RowBox[{"!", 
               RowBox[{"AssociationQ", "[", "analysis", "]"}]}]}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<ERROR: PairwiseSupport analysis failed at row \
\>\"", ",", "k"}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<experimentSeed\>\"", "->", "experimentSeed"}], ",", 
               RowBox[{"\"\<model\>\"", "->", "\"\<TwoPole\>\""}], ",", 
               RowBox[{"\"\<rep\>\"", "->", 
                RowBox[{"sourceRow", "[", "\"\<rep\>\"", "]"}]}], ",", 
               RowBox[{"\"\<n\>\"", "->", 
                RowBox[{"sourceRow", "[", "\"\<n\>\"", "]"}]}], ",", 
               RowBox[{"\"\<m\>\"", "->", 
                RowBox[{"sourceRow", "[", "\"\<m\>\"", "]"}]}], ",", 
               RowBox[{"\"\<lambda\>\"", "->", 
                RowBox[{"sourceRow", "[", "\"\<lambda\>\"", "]"}]}], ",", 
               RowBox[{"\"\<eta\>\"", "->", 
                RowBox[{"sourceRow", "[", "\"\<eta\>\"", "]"}]}]}], "|>"}], ",",
              "analysis"}], "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", "regeneratedProfiles", "]"}]}], "}"}]}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pairwiseRunMinutes", "=", 
     RowBox[{"pairwiseRunSeconds", "/", "60."}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
