   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Checking regenerated profiles against TopSupport \
outcomes...\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"reconstructionChecks", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"regeneratedRow", ",", "canonicalRow"}], "}"}], ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"A", ",", "status"}], "}"}], ",", 
           RowBox[{
            RowBox[{"A", "=", 
             RowBox[{"regeneratedRow", "[", "\"\<profile\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"status", "=", 
             RowBox[{
             "canonicalRow", "[", "\"\<calibrationStatus\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Which", "[", 
             RowBox[{
              RowBox[{"status", "===", "\"\<calibrated\>\""}], ",", 
              RowBox[{
               RowBox[{"SDMWinnerExtended", "[", 
                RowBox[{"A", ",", 
                 RowBox[{"canonicalRow", "[", "\"\<pStar\>\"", "]"}], 
                 ",", "\"\<TopSupport\>\""}], "]"}], "===", 
               RowBox[{
               "canonicalRow", "[", "\"\<selectedCandidate\>\"", "]"}]}], ",", 
              RowBox[{"status", "===", "\"\<degenerate\>\""}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"SDMWinnerExtended", "[", 
                 RowBox[{"A", ",", "1.", ",", "\"\<TopSupport\>\""}], "]"}], "===", 
                RowBox[{"canonicalRow", "[", "\"\<winnerAtPMin\>\"", "]"}]}], 
               "&&", 
               RowBox[{
                RowBox[{"SDMWinnerExtended", "[", 
                 RowBox[{"A", ",", "Infinity", ",", "\"\<TopSupport\>\""}], 
                 "]"}], "===", 
                RowBox[{
                "canonicalRow", "[", "\"\<winnerAtInfinity\>\"", "]"}]}]}], ",",
               "True", ",", "False"}], "]"}]}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"regeneratedProfiles", ",", "topSupportRows"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"reconstructionFailures", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Position", "[", 
       RowBox[{"reconstructionChecks", ",", "False"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Profiles checked: \>\"", ",", 
      RowBox[{"Length", "[", "reconstructionChecks", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Successful checks: \>\"", ",", 
      RowBox[{"Count", "[", 
       RowBox[{"reconstructionChecks", ",", "True"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Failed checks: \>\"", ",", 
      RowBox[{"Length", "[", "reconstructionFailures", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"reconstructionFailures", "=!=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<ERROR: the regenerated sample does not reproduce \>\"", 
         ",", "\"\<the canonical TopSupport outcomes.\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<First failed indices: \>\"", ",", 
         RowBox[{"Take", "[", 
          RowBox[{"reconstructionFailures", ",", 
           RowBox[{"UpTo", "[", "20", "]"}]}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\n", 
