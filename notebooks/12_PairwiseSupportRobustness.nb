   RowBox[{
    RowBox[{"pairwiseIntegrityReport", "=", 
     RowBox[{"TestReport", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"Length", "[", "pairwiseRows", "]"}], ",", 
          "expectedProfiles", ",", 
          RowBox[{
          "TestID", 
           "->", "\"\<Expected PairwiseSupport profile count\>\""}]}], "]"}], 
        ",", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"pairwiseRows", ",", "AssociationQ"}], "]"}], ",", "True", 
          ",", 
          RowBox[{
          "TestID", 
           "->", "\"\<Every PairwiseSupport result is an association\>\""}]}],
          "]"}], ",", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"pairwiseRows", ",", "\"\<legitimacySignal\>\""}], "]"}], 
           "]"}], ",", 
          RowBox[{"{", "\"\<PairwiseSupport\>\"", "}"}], ",", 
          RowBox[{
          "TestID", 
           "->", "\"\<PairwiseSupport signal recorded consistently\>\""}]}], 
         "]"}], ",", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"pairwiseRows", ",", "\"\<experimentSeed\>\""}], "]"}], 
           "]"}], ",", 
          RowBox[{"{", "experimentSeed", "}"}], ",", 
          RowBox[{
          "TestID", "->", "\"\<Experiment seed recorded consistently\>\""}]}],
          "]"}], ",", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"Lookup", "[", 
           RowBox[{"pairwiseRows", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<rep\>\"", ",", "\"\<n\>\"", ",", "\"\<m\>\"", 
              ",", "\"\<lambda\>\"", ",", "\"\<eta\>\""}], "}"}]}], "]"}], ",", 
          RowBox[{"Lookup", "[", 
           RowBox[{"topSupportRows", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<rep\>\"", ",", "\"\<n\>\"", ",", "\"\<m\>\"", 
              ",", "\"\<lambda\>\"", ",", "\"\<eta\>\""}], "}"}]}], "]"}], ",", 
          RowBox[{
          "TestID", 
           "->", "\"\<PairwiseSupport and TopSupport rows are exactly \
paired\>\""}]}], "]"}], ",", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "pairwiseCalibratedRows", "]"}], "+", 
           RowBox[{"Length", "[", "pairwiseDegenerateRows", "]"}]}], ",", 
          "expectedProfiles", ",", 
          RowBox[{
          "TestID", 
           "->", "\"\<Pairwise calibration statuses partition sample\>\""}]}],
          "]"}], ",", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"pairwiseCalibratedRows", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"#", ",", "\"\<geometricRegime\>\""}], "]"}], 
              "===", "\"\<multi-point\>\""}], "&"}]}], "]"}], ",", "True", ",", 
          RowBox[{
          "TestID", 
           "->", "\"\<Every Pairwise calibrated profile is \
multi-point\>\""}]}], "]"}], ",", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"pairwiseNonMultiRows", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"#", ",", "\"\<calibrationStatus\>\""}], "]"}], 
              "===", "\"\<degenerate\>\""}], "&"}]}], "]"}], ",", "True", ",", 
          RowBox[{
          "TestID", 
           "->", "\"\<Every Pairwise non-multi profile is degenerate\>\""}]}],
          "]"}], ",", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"pairwiseCalibratedRows", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"NumericQ", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"#", ",", "\"\<pStar\>\""}], "]"}], "]"}], "&&", 
              RowBox[{"pMin", "<=", 
               RowBox[{"Lookup", "[", 
                RowBox[{"#", ",", "\"\<pStar\>\""}], "]"}], "<=", "pMax"}]}], 
             "&"}]}], "]"}], ",", "True", ",", 
          RowBox[{
          "TestID", 
           "->", "\"\<Every Pairwise calibrated pStar lies in search interval\
\>\""}]}], "]"}], ",", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"pairwiseCalibratedRows", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"NumericQ", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"#", ",", "\"\<areaStar\>\""}], "]"}], "]"}], "&&", 
              RowBox[{
               RowBox[{"Lookup", "[", 
                RowBox[{"#", ",", "\"\<areaStar\>\""}], "]"}], ">", 
               "degenerateEps"}], "&&", 
              RowBox[{
               RowBox[{"Lookup", "[", 
                RowBox[{"#", ",", "\"\<frontSizeAtPStar\>\""}], "]"}], ">=", 
               "3"}]}], "&"}]}], "]"}], ",", "True", ",", 
          RowBox[{
          "TestID", 
           "->", "\"\<Every Pairwise calibration has positive area and \
nondegenerate front\>\""}]}], "]"}], ",", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"pairwiseDegenerateRows", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"MissingQ", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"#", ",", "\"\<pStar\>\""}], "]"}], "]"}], "&&", 
              RowBox[{"MissingQ", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"#", ",", "\"\<areaStar\>\""}], "]"}], "]"}], "&&", 
              RowBox[{"MissingQ", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"#", ",", "\"\<selectedCandidate\>\""}], "]"}], 
               "]"}]}], "&"}]}], "]"}], ",", "True", ",", 
          RowBox[{
          "TestID", 
           "->", "\"\<Pairwise degenerate profiles have no artificial \
calibration\>\""}]}], "]"}], ",", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"pairwiseDegenerateRows", ",", 
            RowBox[{
             RowBox[{"AssociationQ", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"#", ",", "\"\<degenerateDiagnostic\>\""}], "]"}], 
              "]"}], "&"}]}], "]"}], ",", "True", ",", 
          RowBox[{
          "TestID", 
           "->", "\"\<Pairwise degenerate profiles contain \
diagnostic\>\""}]}], "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
