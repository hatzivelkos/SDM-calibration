   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Verifying regenerated profiles against canonical \
outcomes...\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"profileVerificationResults", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"regeneratedRow", ",", "canonicalRow"}], "}"}], ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"A", ",", "status"}], "}"}], ",", 
           RowBox[{
            RowBox[{"A", "=", 
             RowBox[{"regeneratedRow", "[", "\"\<profile\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"status", "=", 
             RowBox[{
             "canonicalRow", "[", "\"\<calibrationStatus\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Which", "[", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"For", " ", "calibrated", " ", "instances"}], ",", 
               RowBox[{
                RowBox[{
                "pStar", " ", "and", " ", "the", " ", "selected", " ", 
                 "candidate", " ", "are", " ", "already", " ", "stored", " ", 
                 "in", " ", "the", " ", "canonical", " ", 
                 RowBox[{"CSV", ".", "Re"}]}], "-", 
                RowBox[{
                "evaluate", " ", "only", " ", "the", " ", "winner", " ", "at",
                  " ", "that", " ", "fixed", " ", 
                 RowBox[{"pStar", "."}]}]}]}], "*)"}], 
             RowBox[{
              RowBox[{"status", "===", "\"\<calibrated\>\""}], ",", 
              RowBox[{
               RowBox[{"SDMWinnerExtended", "[", 
                RowBox[{"A", ",", 
                 RowBox[{"canonicalRow", "[", "\"\<pStar\>\"", "]"}], 
                 ",", "\"\<TopSupport\>\""}], "]"}], "===", 
               RowBox[{
               "canonicalRow", "[", "\"\<selectedCandidate\>\"", "]"}]}], ",", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"For", " ", "degenerate", " ", "instances"}], ",", 
                RowBox[{
                "the", " ", "canonical", " ", "CSV", " ", "stores", " ", 
                 "the", " ", "endpoint", " ", "winners", " ", "used", " ", 
                 "by", " ", "the", " ", "auxiliary", " ", 
                 RowBox[{"diagnostic", ".", "These"}], " ", "can", " ", "be", 
                 " ", "checked", " ", "without", " ", "running", " ", "the", " ",
                  "calibration", " ", "search", " ", 
                 RowBox[{"again", "."}]}]}], "*)"}], 
              RowBox[{"status", "===", "\"\<degenerate\>\""}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"SDMWinnerExtended", "[", 
                 RowBox[{"A", ",", "1.", ",", "\"\<TopSupport\>\""}], "]"}], "===", 
                RowBox[{"canonicalRow", "[", "\"\<winnerAtPMin\>\"", "]"}]}], 
               "&&", 
               RowBox[{
                RowBox[{"SDMWinnerExtended", "[", 
                 RowBox[{"A", ",", "Infinity", ",", "\"\<TopSupport\>\""}], 
                 "]"}], "===", 
                RowBox[{
                "canonicalRow", "[", "\"\<winnerAtInfinity\>\"", "]"}]}]}], ",",
               "True", ",", "False"}], "]"}]}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"regeneratedMainProfiles", ",", "mainRawRows"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
